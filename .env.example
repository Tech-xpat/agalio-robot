# REQUIRED for control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LIVE only — leave empty for paper
WALLET_PRIVATE_KEY=

# true = paper (default). false = real money
DRY_RUN=true

# Optional: extra / paid RPCs (comma-separated)
# RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com

# Optional persistence (Railway-safe)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Safety
MAX_CONCURRENT=1
MIN_POSITION_SOL=0.01
SOL_FEE_RESERVE=0.03
MAX_DAILY_LOSS_PCT=25
MIN_LIQUIDITY_USD=3000
REQUIRE_NO_AUTHORITIES=true

# Paper
DRY_RUN_BALANCE_SOL=1
